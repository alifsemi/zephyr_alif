			pinctrl-0 = <&pinctrl_ut2>;
			pinctrl-1 = <&pinctrl_ut2_sleep>;
			pinctrl-names = "default", "sleep";
			status = "disabled";
		};

		qdec {
			compatible = "alif,utimer-qdec";
