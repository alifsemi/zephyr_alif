		pinctrl-0	 = < &pinctrl_lpcmp >;
		pinctrl-names	 = "default";
		driver_instance	 = "CMP_INSTANCE_LP";
		positive_input	 = "CMP_POS_IN0";
		negative_input	 = "CMP_NEG_IN0";
		hysteresis_level = "42mV";
		status = "disabled";
	};

	i2c0: i2c0@49010000 {
		compatible = "snps,designware-i2c";
		clock-frequency = <I2C_BITRATE_STANDARD>;
		clocks = <&clockctrl ALIF_I2C0_PCLK>;
		/*
		 * For Standard  speed LCNT=0 and HCNT=0
		 * For Fast      speed LCNT=31 and HCNT=31
		 * For Fast Plus speed LCNT=12 and HCNT=12
		 */
		hcnt-offset = <0>;
		lcnt-offset = <0>;
		fs-spike-len = <5>;
		hs-spike-len = <1>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x49010000 0x1000>;
		pinctrl-0 = <&pinctrl_i2c0>;
		pinctrl-1 = <&pinctrl_i2c0_sleep>;
		pinctrl-names = "default", "sleep";
		tx_threshold = <16>;
		rx_threshold = <0>;
		status = "disabled";
	};

	i2c1: i2c1@49011000 {
		compatible = "snps,designware-i2c";
		clock-frequency = <I2C_BITRATE_STANDARD>;
		clocks = <&clockctrl ALIF_I2C1_PCLK>;
		/*
		 * For Standard  speed LCNT=0 and HCNT=0
		 * For Fast      speed LCNT=31 and HCNT=31
		 * For Fast Plus speed LCNT=12 and HCNT=12
		 */
		hcnt-offset = <0>;
		lcnt-offset = <0>;
		fs-spike-len = <5>;
		hs-spike-len = <1>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x49011000 0x1000>;
		pinctrl-0 = <&pinctrl_i2c1>;
		pinctrl-1 = <&pinctrl_i2c1_sleep>;
		pinctrl-names = "default", "sleep";
		tx_threshold = <16>;
		rx_threshold = <0>;
		status = "disabled";
	};

	lpi2c0: lpi2c0@43009000 {
		compatible = "alif,lpi2c";
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_lpi2c0>;
		reg = <0x43009000 0x100>;
		status = "disabled";
	};

	i3c0: i3c0@49034000 {
		compatible      = "snps,designware-i3c";
		#address-cells  = <3>;
		#size-cells     = <0>;
		reg             = <0x49034000 0x1000>;
		clocks          = <&clockctrl ALIF_I3C_CLK>;
		pinctrl-0       = <&pinctrl_i3c0>;
		pinctrl-1       = <&pinctrl_i3c0_recovery>;
		pinctrl-2       = <&pinctrl_i3c0_sleep>;
		pinctrl-names   = "default", "recovery", "sleep";
		i3c-scl-hz      = <10000000>;
		i2c-scl-hz      = <400000>;
		status          = "disabled";
	};

	can0: can@49036000 {
		compatible      = "cast,can";
		reg             = <0x49036000 0x1000 0x49037000 0x1000>;
		reg-names       = "can_reg", "can_cnt_reg";
		clocks          = <&clockctrl ALIF_CANFD0_160M_CLK>;
		clock-frequency = <20000000>;
		pinctrl-0       = <&pinctrl_can0>;
		pinctrl-names   = "default";
		can-fd;
		can-fd-ctrl-reg	= <0x4902F00C>;
		can-fd-bit	= <20>;
		status          = "disabled";
	};

	i2s0: i2s0@49014000 {
		compatible = "snps,designware-i2s";
		reg = <0x49014000 0x1000>;
		power-domains = <&pd_syst>;
		pinctrl-0 = <&pinctrl_i2s0>;
		pinctrl-1 = <&pinctrl_i2s0_sleep>;
		pinctrl-names = "default", "sleep";
		clocks = <&clockctrl ALIF_I2S0_76M8_CLK>;
		status = "disabled";
	};

	i2s1: i2s1@49015000 {
		compatible = "snps,designware-i2s";
		reg = <0x49015000 0x1000>;
		power-domains = <&pd_syst>;
		pinctrl-0 = <&pinctrl_i2s1>;
		pinctrl-1 = <&pinctrl_i2s1_sleep>;
		pinctrl-names = "default", "sleep";
		clocks = <&clockctrl ALIF_I2S1_76M8_CLK>;
		status = "disabled";
	};

	i2s4: lpi2s@43001000 {
		compatible = "snps,designware-i2s";
		reg = <0x43001000 0x1000>;
		pinctrl-0 = <&pinctrl_lpi2s>;
		pinctrl-1 = <&pinctrl_lpi2s_sleep>;
		pinctrl-names = "default", "sleep";
		clocks = <&clockctrl ALIF_LPI2S_76M8_CLK>;
		status = "disabled";
	};
	ospi0: ospi0@83000000 {
		compatible = "snps,designware-ospi";
		reg = <0x83000000 0x1000>;
		pinctrl-0 = <&pinctrl_ospi0>;
		pinctrl-names = "default";
		aes-reg = <0x83001000 0x100>;
		clocks = <&clockctrl ALIF_OSPI0_ACLK_CLK>;
		bus-speed = <100000000>;
		cs-pin = <0>;
		ddr-drive-edge = <1>;
		rx-ds-delay = <11>;
		tx-fifo-threshold = <0>;
		xip-wait-cycles = <255>;
		xip-base-address = <0xA0000000 0x10000000>;
		status = "disabled";
	};

	ethernet: ethernet@48100000 {
		compatible = "alif,ethernet", "snps,designware-ethernet";
		reg = <0x48100000 0x1000>;
		pinctrl-0 = <&pinctrl_eth>;
		pinctrl-names = "default";
		clocks = <&clockctrl ALIF_ETHERNET_CLK>;
		local-mac-address = [02 01 56 78 43 21];
		status = "disabled";

		mdio: mdio {
			compatible = "snps,designware-mdio";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			ethernet_phy: ethernet_phy@1 {
				compatible = "realtek,rtl8201fr";
				reg = <1>;
				phy_mode = "PHY_AUTO_NEGOTIATE";
				status = "disabled";
			};
		};
	};

	cdc200: cdc200@49031000 {
		compatible = "tes,cdc-2.1";
		reg = <0x49031000 0x1000>;
		status = "okay";
		pinctrl-0 = < &pinctrl_cdc200 >;
		pinctrl-names = "default";

		clocks = <&clockctrl ALIF_DPI_CLK>, <&clockctrl ALIF_CDC200_PIX_SYST_ACLK>;
		clock-names = "dpi-clk-en", "pixel-clk";

		/* Panel Config */
		width = <800>;
		height = <480>;
		hfront-porch = <210>;
		hback-porch = <46>;
		hsync-len = <1>;
		vfront-porch = <22>;
		vback-porch = <23>;
		vsync-len = <1>;
		hsync-active = <0>;
		vsync-active = <0>;
		de-active = <1>;
		pixelclk-active = <0>;
		clock-frequency = <2779910>;
		/* BG Layer color is 24-bit in size. */
		bg-color = <0x5a5a5a>;

		/* Layer 0 Config */
		enable-l1 = <1>;
		pixel-fmt-l1 = "rgb-565";
		/* Default color for Layer is 32-bit in size. */
		def-back-color-l1 = <0x00ff00>;
		win-x0-l1 = <0>;
		win-y0-l1 = <0>;
		win-x1-l1 = <300>;
		win-y1-l1 = <480>;
		blend-factor1-l1 = <4>;
		blend-factor2-l1 = <5>;
		const-alpha-l1 = <0x7f>;

		/* Layer 1 Config */
		enable-l2 = <1>;
		pixel-fmt-l2 = "argb-8888";
		win-x0-l2 = <500>;
		win-y0-l2 = <0>;
		win-x1-l2 = <800>;
		win-y1-l2 = <68>;
		blend-factor1-l2 = <4>;
		blend-factor2-l2 = <5>;
		const-alpha-l2 = <0xaf>;
	};

	mipi_dsi: mipi-dsi@49032000 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "snps,designware-dsi";
		reg = <0x49032000 0x1000>;
		cdc-if = <&cdc200>;
		phy-if = <&dphy 1>;

		clocks = <&clockctrl ALIF_DSI_CLK>, <&clockctrl ALIF_CDC200_PIX_SYST_ACLK>,
			<&clockctrl ALIF_MIPI_TXDPHY_CLK>;
		clock-names = "dsi-clk-en", "pixel-clk", "tx-dphy-clk";
		dpi-shutdn-active = <1>;
		dpi-colorm-active = <1>;
		vid-pkt-size = <480>;
		ecc-recv-en;
		crc-recv-en;
		frame-ack-en;
		status = "disabled";

		mw405: mw405@0 {
			status = "okay";
			compatible = "focuslcds,mw405";
			reg = <0>;
			reset-gpios = <&lpgpio 5 GPIO_ACTIVE_HIGH>;
			bl-gpios = <&gpio6 1 GPIO_ACTIVE_HIGH>;
			data-lanes = <2>;
			width = <480>;
			height = <800>;
			video-mode = "burst";
			command-tx-mode = "high-speed";
			pixel-format = <MIPI_DSI_PIXFMT_RGB888>;
			status = "okay";
		};
	};

	dphy: d-phy@4903f000{
		compatible = "snps,designware-dphy";
		reg = <0x4903f000 0x40>,
		      <0x49033000 0x1000>,
		      <0x49032000 0x1000>;
		reg-names = "expmst_reg", "csi_reg", "dsi_reg";

		#dphy-cells = <1>;

		clocks = <&clockctrl ALIF_MIPI_PLLREF_CLK>, <&clockctrl ALIF_MIPI_BYPASS_CLK>,
			 <&clockctrl ALIF_MIPI_TXDPHY_CLK>, <&clockctrl ALIF_MIPI_RXDPHY_CLK>;
		clock-names = "pllref-clk", "pllbypass-clk", "tx-dphy-clk", "rx-dphy-clk" ;

		ref-frequency = <38400000>;
		cfg-clk-frequency = <25000000>;
		status = "okay";
	};
};

&{/} {

/*
 * Should be move at the ensemble_apss/rtss.dtsi level
 * se_service: se_service {
 * 	compatible = "alif,secure-enclave-services";
 * 	mhuv2-send-node = <&seservice0s>;
 * 	mhuv2-recv-node = <&seservice0r>;
 * 	status = "okay";
 * };
 *
 * rng: rng {
 * 	status = "okay";
 * 	compatible = "alif,secure-enclave-trng";
 * };
 */
/* Should be move at the ensemble_apss/rtss.dtsi level or the board level
 * aliases {
 * 	mipi-dsi = &mipi_dsi;
 * 	panel = &mw405;
 * };
 *
 * chosen {
 * 	zephyr,entropy = &rng;
 * 	zephyr,flash-controller = &mram_flash;
 * 	zephyr,display = &cdc200;
 * };
 */
	clocks {
		lfrc: lfrc {
			compatible = "fixed-clock";
			clock-frequency = <32000>;
			status = "okay";
			#clock-cells = <0>;
		};

		lfxo: lfxo {
			compatible = "fixed-clock";
			clock-frequency = <32768>;
			status = "okay";
			#clock-cells = <0>;
		};

		hfrc: hfrc {
			compatible = "fixed-clock";
			clock-frequency = <76800000>;
			status = "okay";
			#clock-cells = <0>;
		};

		hfxo: hfxo {
			compatible = "fixed-clock";
			clock-frequency = <38400000>;
			status = "okay";
			#clock-cells = <0>;
		};

		pll_clk1: pll_clk1 {
			compatible = "alif,clock";
			clock-frequency = <800000000>;
			status = "okay";
			#clock-cells = <0>;
		};

		syst_aclk: axi_clk {
			compatible = "alif,clock";
			clock-frequency = <400000000>;
			status = "okay";
			#clock-cells = <0>;
		};

		syst_hclk: ahb_clk {
			compatible = "alif,clock";
			clock-frequency = <200000000>;
			status = "okay";
			#clock-cells = <0>;
		};

		clk_38p4m: clk_38p4m {
			compatible = "fixed-clock";
			clock-frequency = <38400000>;
			status = "disabled";
			#clock-cells = <0>;
		};

		clk_20m: clk_20m {
			compatible = "fixed-clock";
			clock-frequency = <20000000>;
			status = "disabled";
			#clock-cells = <0>;
		};

		clk_100m: clk_100m {
			compatible = "fixed-clock";
			clock-frequency = <100000000>;
			status = "disabled";
			#clock-cells = <0>;
		};

		clk_160m: clk_160m {
			compatible = "fixed-clock";
			clock-frequency = <160000000>;
			status = "disabled";
			#clock-cells = <0>;
		};
	};
};
