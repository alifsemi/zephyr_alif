			filter-prescaler = <16>;
			filter-taps = <1>;
			pinctrl-0 = <&pinctrl_ut2>;
			pinctrl-1 = <&pinctrl_ut2_sleep>;
			pinctrl-names = "default", "sleep";
			status = "disabled";
		};
	};

	utimer3: utimer@48004000 {
		compatible = "alif,utimer";
