def utils
def rebaseNeeded       = "-1"
def allRecipientEmails = ""
def labels             = [ "BUILD_AWAITING", "BUILD_FAILED", "BUILD_PASSED", "CHECKPATCH_FAILED" ]
def job_config = [
    github_creds_id : "27c5d944-f190-4ab7-8c37-23cc43c7ce11"
]

pipeline {
    agent any

    environment {
        GITHUB_USER_OR_ORG_NAME = sh(script: 'echo ${CHANGE_URL:-alifsemi}    | sed -E "s#https://github.com/([^/]+)/([^/]+)/.*#\\1#"', returnStdout: true).trim()
        GITHUB_REPO_NAME        = sh(script: 'echo ${CHANGE_URL:-zephyr_alif} | sed -E "s#https://github.com/([^/]+)/([^/]+)/.*#\\2#"', returnStdout: true).trim()
        CHANGE_TARGET           = sh(script: 'echo ${CHANGE_TARGET:-main}', returnStdout: true).trim()
        GITHUB_TOKEN            = credentials('27c5d944-f190-4ab7-8c37-23cc43c7ce11')
        PATH                    = "${env.PATH}:$HOME/.local/bin"
    }

    options {
        skipDefaultCheckout(true)
    }

    stages {
        stage('Install Dependencies') {
            steps {
                script {
                    job_config.owner  = "${GITHUB_USER_OR_ORG_NAME}"
                    job_config.user   = "${GITHUB_TOKEN_USR}"
                    job_config.repo   = "${GITHUB_REPO_NAME}"
                    job_config.branch = "${CHANGE_TARGET}"
                    job_config.token  = GITHUB_TOKEN_PSW
                    job_config.pr_repo        = "${GITHUB_REPO_NAME}"
                    job_config.changeId       = "${CHANGE_ID}"
                    job_config.manifest_repo  = "sdk-alif"

                    sh '''#!/bin/bash -xe
                    if ! command -v gitlint >/dev/null 2>&1; then
                        echo "gitlint not found. Installing gitlint..."
                        python3 -m pip install --user -q gitlint
                    fi
                    if ! command -v jq >/dev/null 2>&1; then
                        echo "jq not found. Installing..."

                        mkdir -p "$HOME/.local/bin" && wget --tries=5 --timeout=30 --waitretry=5 \
                            --retry-connrefused --https-only -q -O "$HOME/.local/bin/jq" \
                            "https://github.com/jqlang/jq/releases/latest/download/jq-linux-amd64" && \
                        chmod 755 "$HOME/.local/bin/jq"
                    fi
                    git config --list
                    [ -n "$(git config --global --get user.name)" ]  || git config --global user.name "Alif-CI"
                    [ -n "$(git config --global --get user.email)" ] || git config --global user.email "alif-ci@alifsemi.com"
                    '''
                }
            }
        }

        stage('Display Environment Variables') {
            steps {
                script {
                    sh """#!/bin/bash -xe
                        printenv
                        echo -e "🛠️ $PATH"
                        echo -e "✔️ Displayed all environment setting."
                    """
                }
            }
        }

        stage('checkout') {
            steps {
                cleanWs()
                echo "⏳ Checking out '${GITHUB_REPO_NAME}' repo..."

                dir("${GITHUB_REPO_NAME}") {
                    checkout scm
                }
                script {
                    utils = load "${GITHUB_REPO_NAME}/automation/utils/Utils.groovy"
                    utils.init(job_config)
                }

                script {
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                        sh '''#!/bin/bash
                        set -xe
                        echo -e "✅ Checkout is completed "${GITHUB_REPO_NAME}"."

                        if [ ! -d "${GITHUB_REPO_NAME}" ] ; then
                            echo -e "🚫 ${GITHUB_REPO_NAME} directory didn't found."
                            exit -1
                        fi
                        '''
                    }
                }

                script {
                    rebaseNeeded = sh(
                        script: '''#!/bin/bash
                            set -xe
                            cd ${GITHUB_REPO_NAME}
                            git fetch origin refs/heads/${CHANGE_TARGET}:refs/remotes/origin/${CHANGE_TARGET}

                            if ! git rebase origin/${CHANGE_TARGET} ; then
                                echo -e "Rebase could not happen successfully"
                                exit 1
                            fi

                            commitCnt=$(git rev-list --count origin/${CHANGE_TARGET}..HEAD)
                            commits=$(git log -n ${commitCnt} --pretty=format:"%H")

                            if [[ "$commitCnt" -lt "1" ]] ; then
                                echo 0
                                exit 0
                            fi

                            firstCommit=$(git log -n 1 --pretty=format:"%H")
                            firstCommit_author_name=$(git show -s --format="%an" "$firstCommit")
                            firstCommit_author_email=$(git show -s --format="%ae" "$firstCommit")
                            firstCommit_body=$(git show -s --format="%b" "$firstCommit" | tail -n +1 | awk '!/^[A-Za-z-]+:/ {print}' | sed '/^$/d')
                            parentCnt=$(git log -n 1 --pretty=format:"%p"  | wc -w)

                            if [[ "$firstCommit_author_name" == "Jenkins" || "$firstCommit_author_email" == "nobody@nowhere" || \
                                  "$firstCommit_body" == "*Merge commit \'$firstCommit\' into HEAD*" || "$parentCnt" -gt "1" || \
                                  "$firstCommit_author_name" == "Alif-CI" || "$firstCommit_author_email" == "alif-ci@alifsemi.com" ]] ; then
                                git reset --soft HEAD~1
                                echo 1
                            else
                                echo 0
                            fi
                            ''',
                        returnStdout: true
                    ).trim()
                     echo "🎯 rebase needed: [${rebaseNeeded}]..."
                }
            }
        }

        stage('Get PR Message/Authors') {
            steps {
                script {
                    allRecipientEmails = sh(
                        script: '''#!/bin/bash
                            set -xe
                            cd ${GITHUB_REPO_NAME}
                            commitCnt=$(git rev-list --count origin/${CHANGE_TARGET}..HEAD)

                            # Get all author emails for this PR
                            culpritEmails=$(git log -n $commitCnt --pretty=format:'%ae' | sort | uniq | paste -sd";" -)

                            # Replace all commas with semicolons
                            defaultEmails=$(echo "$DEFAULT_OWNER_EMAILS" | tr ',' ';')

                            all_emails="$culpritEmails;$defaultEmails;test@st.com"
                            all_unique_emails=$(echo "$all_emails" | tr ';' '\n' | grep -v '^$' | sort -u | paste -sd ";" -)
                            echo "$all_unique_emails" | tr ';' '\n' | grep '@alifsemi.com$' | paste -sd';' -
                        ''',
                        returnStdout: true
                    ).trim()
                    echo "📤 Mail will be sent to: [${allRecipientEmails}]..."
                }
            }
        }

        stage('CheckPatch and Commit Message Validation') {
            steps {
                script {
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                        sh """#!/bin/bash
                        set -xe
                        cd \${GITHUB_REPO_NAME}

                        commitCnt=\$(git rev-list --count origin/${CHANGE_TARGET}..HEAD)
                        totalCommitCnt=\$(git rev-list --count origin/${CHANGE_TARGET})

                        if [[ "\$totalCommitCnt" -lt "\$commitCnt" ]] ; then
                            checkGitLog=\${commitCnt}
                        else
                            checkGitLog=6
                        fi
                        git log -\${checkGitLog}

                        echo -e "🎯 we have \$commitCnt commits in \$CHANGE_TARGET review"
                        if [[ "\${commitCnt}" =~ ^[0-9]+\$ && "\${commitCnt}" -gt "0" ]] ; then
                            git format-patch -\${commitCnt}
                            check_patch_output=\$(./scripts/checkpatch.pl --patch *.patch)
                            echo -e "\$check_patch_output"
                            check_patch_output_summary=\$(echo "\$check_patch_output" | grep ".patch total:")
                            echo -e "\$check_patch_output_summary"

                            check_patch_errors=0
                            check_patch_warnings=0
                            check_patch_lines=0

                            while read -r line; do
                              # Extract numbers using regex or field parsing
                              err=\$(echo "\$line"  | awk '{for(i=1;i<=NF;i++) if(\$i=="total:") print \$(i+1)}')
                              warn=\$(echo "\$line" | awk '{for(i=1;i<=NF;i++) if(\$i=="errors,") print \$(i+1)}')
                              ln=\$(echo "\$line"   | awk '{for(i=1;i<=NF;i++) if(\$i=="warnings,") print \$(i+1)}')

                              if [[ "\$err" =~ ^[0-9]+\$ ]]; then
                                check_patch_errors=\$((check_patch_errors + err))
                              else
                                echo "Skipping non-numeric error: \$err"
                              fi

                              if [[ "\$warn" =~ ^[0-9]+\$ ]]; then
                                check_patch_warnings=\$((check_patch_warnings + warn))
                              else
                                echo "Skipping non-numeric warning: \$warn"
                              fi

                              if [[ "\$ln" =~ ^[0-9]+\$ ]]; then
                                check_patch_lines=\$((check_patch_lines + ln))
                              else
                                echo "Skipping non-numeric lines: \$ln"
                              fi

                            done <<< "\$check_patch_output_summary"

                            echo -e "🎯Check-Patch has=> Errors: \${check_patch_errors} Warnings: \${check_patch_warnings}, Lines: \${check_patch_lines}\n\n"

                            gitlint_log=\$(git log -\${commitCnt} --pretty=%B | gitlint 2>&1)
                            if [ -n "\$gitlint_log" ] ; then
                                gitlint_err=1
                                echo -e "🎯GITLINT log=>\n\$gitlint_log"
                            else
                               gitlint_err=0
                            fi
                        else
                            gitlint_err=0
                            check_patch_errors=0
                        fi
                        echo -e " 🏆Git Rebase Needed  =>  ${rebaseNeeded}"
                        echo -e " 🏆GitLint Result     =>  \${gitlint_err}"
                        echo -e " 🏆Check-Patch Result =>  Error: \$check_patch_errors, Warnings: \$check_patch_warnings"
                        """
                    }

                    withCredentials([usernamePassword(credentialsId: job_config.github_creds_id,
                        usernameVariable: 'GITHUB_TOKEN_USR', passwordVariable: 'GITHUB_TOKEN')]) {
                        for (String label : labels) {
                            echo "remove existing build labels [$label]"
                            job_config.label = label
                            utils.github.removeLabel(job_config)
                        }
                    }
                }
            }
        }
    }

    post {
        failure {
            echo "🚫 Build failed. Sending email..."
            script {
                emailext (
                    subject: "🚨 Jenkins Job Failed: ${env.JOB_NAME} [${env.BUILD_NUMBER}]",
                    body: """
                       <p>Build failed for job: <b>${env.CHANGE_URL}</b></p>
                       <p>Build Number: <b>${env.BUILD_NUMBER}</b></p>
                       <p>View details: <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
                    """,
                    to : "${allRecipientEmails}",
                    mimeType: 'text/html'
                )
                withCredentials([usernamePassword(credentialsId: job_config.github_creds_id,
                        usernameVariable: 'GITHUB_TOKEN_USR', passwordVariable: 'GITHUB_TOKEN')]) {
                            job_config.label = labels[3]
                            echo "Add labels=> ${job_config.label}"
                            utils.github.addLabel(job_config)
                    }
            }
        }

        success {
            echo "🟢 UPDATING CORRESPONDING SHA/COMMIT-ID IN MANIFEST FILE OF ALIF_SDK 🟢"
            script {
                withCredentials([usernamePassword(credentialsId: '27c5d944-f190-4ab7-8c37-23cc43c7ce11',
                    usernameVariable: 'GITHUB_TOKEN_USR', passwordVariable: 'GITHUB_TOKEN')]) {
                    job_config.label = labels[0]
                    echo "Add labels=>  ${job_config.label}"
                    utils.github.addLabel(job_config)
                    def gitAuth = sh(script: ''' printf "%s:%s" "$GITHUB_TOKEN_USR" "$GITHUB_TOKEN" | base64 -w0
                            ''', returnStdout: true).trim()
                    utils.git.clone("https://github.com/${job_config.user}/${job_config.manifest_repo}", gitAuth)
                    if (!fileExists(job_config.manifest_repo)) {
                        echo "Directory does not exist: ${job_config.manifest_repo}"
                    } else {
                        dir(job_config.manifest_repo) {
                            String manifestUpdatedBranch ="${job_config.manifest_repo}_PR${job_config.changeId}"
                            job_config.manifestUpdatedBranch = manifestUpdatedBranch
                            echo "MANIFEST_UPDATED_BRANCH = ${manifestUpdatedBranch}"
                            job_config.repo = job_config.pr_repo
                            utils.git.updateForkWithRemote(job_config, "main")
                            utils.git.push("origin", "main", gitAuth)
                            utils.git.updateForkWithRemote(job_config, "${manifestUpdatedBranch}")
                            utils.git.push("origin", "${manifestUpdatedBranch}", gitAuth)
                            def checkout_sha = utils.git.currentCommit()
                            echo "checkout version : ${checkout_sha}"
                            job_config.repo = job_config.pr_repo
                            String searchText =
                                "https://github.com/${job_config.owner}/${job_config.repo}/pull/${job_config.changeId}"

                            echo "Searching for manifest PR..."
                            echo "Search text: ${searchText}"

                            int openPRCount = 0
                            job_config.state = "open"
                            job_config.repo = job_config.manifest_repo
                            def prs = utils.github.listPullRequests(job_config)
                            def updateManifestPRnumber = null

                            if (prs instanceof List) {
                                openPRCount = prs.size()
                                echo "Open PR count: ${openPRCount}"

                                for (def pr : prs) {
                                    if (pr.body?.contains(searchText)) {
                                        updateManifestPRnumber = pr.changeId
                                        break
                                    }
                                }
                            }

                            if (updateManifestPRnumber != null) {
                                echo "Manifest update found in PR-${updateManifestPRnumber}"
                                job_config.updateManifestPRnumber = updateManifestPRnumber
                                utils.git.customCmd(" commit --amend --no-edit")
                                utils.git.push("origin", "${manifestUpdatedBranch}", gitAuth)
                            } else {
                                echo "No existing manifest update PR found"
                                def updated_rev="pull/${CHANGE_ID}/head"
                                def content = readFile('west.yml')
                                def pattern = /(?m)^([ \t]*repo-path:[ \t]*${job_config.pr_repo}[ \t]*\r?\n)([ \t]*revision:[ \t]*)([^\r\n]+)(\r?\n)/

                                if (content =~ pattern) {
                                    def oldRevision = (content =~ pattern)[0][3]
                                    echo "Found ${job_config.pr_repo} in west.yml"
                                    content = content.replaceFirst(pattern, "\$1\$2${updated_rev}\$4")
                                    writeFile(file: 'west.yml', text: content)
                                    echo "Updated revision for ${job_config.pr_repo} ${oldRevision} to ${updated_rev}"
                                } else {
                                    echo "repo-path '${job_config.pr_repo}' not found in west.yml"
                                }
                                def pr_title = utils.github.getPullRequestTitle(job_config)
                                def prBody   = utils.github.getPullRequestBody(job_config)
                                def manifestMsg = "manifest update for ${pr_title}"
                                def gitHubURL   = "https://github.com"
                                def manifestPRpath = "${job_config.owner}/${job_config.pr_repo}/pull/${job_config.changeId}"
                                utils.git.status()
                                utils.git.commit(manifestMsg)
                                utils.git.status()
                                utils.git.push("origin", "${manifestUpdatedBranch}", gitAuth)
                                echo "pr title : [${pr_title}]"
                                echo "pr Body : [${prBody}]"
                                job_config.repo  = job_config.manifest_repo
                                job_config.title = manifestMsg
                                job_config.head  = "${job_config.user}:${manifestUpdatedBranch}"
                                job_config.base  = "${job_config.branch}"
                                job_config.body  = "${pr_title}\r\n\r\nThis PR depends on: ${gitHubURL}/${manifestPRpath}"

                                utils.github.createPullRequest(job_config)
                            }
                        }
                    }
                }
            }
        }

        cleanup {
            echo "Cleaning up workspace..."
            deleteDir()
        }
    }
}
