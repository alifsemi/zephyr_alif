menu "MSPI MEMC device driver"

config MEMC_MSPI
	bool
	select MSPI
	help
	  MSPI MEMC drivers are enabled.

config MEMC_MSPI_APS6404L
	bool "MSPI AP Memory APS6404L pSRAM driver"
	default y
	depends on DT_HAS_APS6404L_ENABLED
	depends on $(dt_compat_on_bus,$(DT_COMPAT_APS6404L),mspi)
	select MEMC_MSPI
	select MSPI_AMBIQ_CONTROLLER if SOC_FAMILY_AMBIQ

config MEMC_MSPI_APS_Z8
	bool "MSPI AP Memory gen Z8 pSRAM driver"
	default y
	depends on DT_HAS_APS_Z8_ENABLED
	depends on $(dt_compat_on_bus,$(DT_COMPAT_APS_Z8),mspi)
	select MEMC_MSPI
	select MSPI_AMBIQ_CONTROLLER if SOC_FAMILY_AMBIQ

config MEMC_MSPI_IS66WV
	bool "MSPI ISSI IS66WV pSRAM driver"
	default y
	depends on DT_HAS_IS66WV_ENABLED
	depends on $(dt_compat_on_bus,$(DT_COMPAT_IS66WV),mspi)
	select MEMC_MSPI
	select MSPI_AMBIQ_CONTROLLER if SOC_FAMILY_AMBIQ

config MEMC_MSPI_IS66WVH
	bool "MSPI ISSI IS66WVH HyperRAM driver"
	default y
	depends on DT_HAS_ISSI_IS66WVH_ENABLED
	depends on $(dt_compat_on_bus,$(DT_COMPAT_ISSI_IS66WVH),mspi)
	select MEMC_MSPI
	help
	  Enable memory-mapped ISSI IS66/67WVH HyperRAM devices connected
	  to a HyperBus-capable MSPI controller. MSPI_XIP must be enabled
	  because this driver accesses the device through a memory-mapped
	  read/write window.

endmenu
